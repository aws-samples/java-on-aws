{
  "workload": {
    "namespace": "unicorn-store-spring",
    "deployment": "unicorn-store-spring",
    "container": "unicorn-store-spring",
    "imageTag": "latest",
    "replicas": 1,
    "cpuRequestCores": 1.0,
    "cpuLimitCores": 1.0,
    "memRequestMi": 2048.0,
    "memLimitMi": 2048.0,
    "cpuResizePolicy": false,
    "javaToolOptions": null,
    "sidecars": ["perf-profiler"]
  },
  "runtime": {
    "rssFloorMi": 400.0,
    "rssPeakMi": 480.0,
    "heapUsedMi": 60.0,
    "heapCommittedMi": 90.0,
    "gcName": "SerialGC",
    "effectiveCpuCount": 1,
    "startupSeconds": 13.0,
    "restarts": 1,
    "uptimeSeconds": 30.0,
    "requestRatePerSec": 40
  },
  "profile": {
    "topCpu": [
      {"name": "PhaseIdealLoop::build_loop_tree", "selfPct": 22.0},
      {"name": "Compile::Optimize", "selfPct": 20.0}
    ],
    "topWall": [{"name": "jdk/internal/misc/Unsafe.park", "selfPct": 25.0}],
    "jitSharePct": 42.0,
    "gcSharePct": 6.0,
    "futexWallSharePct": 30.0,
    "warmupWindow": true,
    "samples": 2000
  },
  "threads": {
    "threadCountByState": {"RUNNABLE": 12, "TIMED_WAITING": 10},
    "poolWaitCarriers": 0,
    "futureGetOnRequestPath": false
  }
}
