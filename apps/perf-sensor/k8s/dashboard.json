{
  "title": "Java on EKS — Sensor",
  "uid": "perf-sensor-eks",
  "tags": ["optimization","java","workshop","perf-sensor"],
  "timezone": "browser", "schemaVersion": 39, "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" }, "templating": { "list": [] },
  "panels": [
    { "type": "row", "id": 100, "title": "At a glance", "gridPos": {"x":0,"y":0,"w":24,"h":1} },
    { "type": "stat", "id": 1, "title": "Startup (ready time)", "gridPos": {"x":0,"y":1,"w":5,"h":4},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"s"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"max(perf_sensor_startup_seconds{service=\"__APP_NS__\"}) or max(application_ready_time_seconds{application=\"__APP_NS__\"})"}] },
    { "type": "stat", "id": 2, "title": "Request latency (max)", "gridPos": {"x":5,"y":1,"w":5,"h":4},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"s"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"max(http_server_requests_seconds_max{application=\"__APP_NS__\",uri!~\"/actuator.*\"})"}] },
    { "type": "stat", "id": 3, "title": "Memory reserved (fleet)", "gridPos": {"x":10,"y":1,"w":5,"h":4},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"bytes"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"sum(kube_pod_container_resource_limits{namespace=\"__APP_NS__\",container=\"__APP_NS__\",resource=\"memory\"})"}] },
    { "type": "stat", "id": 4, "title": "Memory used (fleet)", "gridPos": {"x":15,"y":1,"w":5,"h":4},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"bytes"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"sum(max by (pod)(container_memory_working_set_bytes{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} and on(pod) (kube_pod_container_status_running{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} == 1)))"}] },
    { "type": "stat", "id": 5, "title": "Pods ready", "gridPos": {"x":20,"y":1,"w":4,"h":4},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"short"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"max(kube_deployment_status_replicas_ready{namespace=\"__APP_NS__\",deployment=\"__APP_NS__\"})"}] },
    { "type": "row", "id": 200, "title": "Trends", "gridPos": {"x":0,"y":5,"w":24,"h":1} },
    { "type": "timeseries", "id": 6, "title": "Fleet memory: reserved vs used", "gridPos": {"x":0,"y":6,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"bytes"}},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"sum(kube_pod_container_resource_limits{namespace=\"__APP_NS__\",container=\"__APP_NS__\",resource=\"memory\"})","legendFormat":"reserved (limit x pods)"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"sum(max by (pod)(container_memory_working_set_bytes{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} and on(pod) (kube_pod_container_status_running{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} == 1)))","legendFormat":"used (working set)"}] },
    { "type": "timeseries", "id": 7, "title": "Request latency (avg / max)", "gridPos": {"x":12,"y":6,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"promds"},
      "fieldConfig": {"defaults":{"unit":"s"},
        "overrides": [
          {"matcher":{"id":"byName","options":"avg"},"properties":[{"id":"custom.scaleDistribution","value":{"type":"log","log":10}}]},
          {"matcher":{"id":"byName","options":"max"},"properties":[{"id":"custom.axisPlacement","value":"right"}]}]},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"sum(rate(http_server_requests_seconds_sum{application=\"__APP_NS__\",uri!~\"/actuator.*\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"__APP_NS__\",uri!~\"/actuator.*\"}[1m]))","legendFormat":"avg"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"max(http_server_requests_seconds_max{application=\"__APP_NS__\",uri!~\"/actuator.*\"})","legendFormat":"max"}] },
    { "type": "timeseries", "id": 8, "title": "Startup per pod (ready time)", "gridPos": {"x":0,"y":14,"w":12,"h":8},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^(working set )?.*-([a-z0-9]{5})$","renamePattern":"$1$2"}}],
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"s"}},
      "targets": [{"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
        "expr":"max by (pod)(perf_sensor_startup_seconds{service=\"__APP_NS__\"}) or max by (pod)(application_ready_time_seconds{application=\"__APP_NS__\"})","legendFormat":"{{pod}}"}] },
    { "type": "timeseries", "id": 9, "title": "Working set vs limit (per pod)", "gridPos": {"x":12,"y":14,"w":12,"h":8},
      "transformations": [{"id":"renameByRegex","options":{"regex":"^(working set )?.*-([a-z0-9]{5})$","renamePattern":"$1$2"}}],
      "datasource": {"type":"prometheus","uid":"promds"}, "fieldConfig": {"defaults":{"unit":"bytes"}},
      "targets": [
        {"refId":"A","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"max by (pod)(container_memory_working_set_bytes{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} and on(pod) (kube_pod_container_status_running{namespace=\"__APP_NS__\",container=\"__APP_NS__\"} == 1))","legendFormat":"working set {{pod}}"},
        {"refId":"B","datasource":{"type":"prometheus","uid":"promds"},
         "expr":"max(kube_pod_container_resource_limits{namespace=\"__APP_NS__\",container=\"__APP_NS__\",resource=\"memory\"})","legendFormat":"limit"}] }
  ]
}
