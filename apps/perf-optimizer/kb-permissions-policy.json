{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3DataBucket",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::perf-optimizer-kb-data-*",
        "arn:aws:s3:::perf-optimizer-kb-data-*/*"
      ]
    },
    {
      "Sid": "S3Vectors",
      "Effect": "Allow",
      "Action": ["s3vectors:*"],
      "Resource": "*"
    },
    {
      "Sid": "IamRoleForKb",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:PutRolePolicy"],
      "Resource": [
        "arn:aws:iam::664418970595:role/perf-optimizer-kb-role",
        "arn:aws:iam::664418970595:role/perf-analyzer-eks-pod-role"
      ]
    },
    {
      "Sid": "IamPassRoleToBedrock",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": "arn:aws:iam::664418970595:role/perf-optimizer-kb-role"
    },
    {
      "Sid": "BedrockKnowledgeBase",
      "Effect": "Allow",
      "Action": [
        "bedrock:CreateKnowledgeBase", "bedrock:GetKnowledgeBase", "bedrock:ListKnowledgeBases",
        "bedrock:CreateDataSource", "bedrock:ListDataSources",
        "bedrock:StartIngestionJob", "bedrock:GetIngestionJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmKbId",
      "Effect": "Allow",
      "Action": ["ssm:PutParameter", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:*:664418970595:parameter/perf-optimizer/*"
    }
  ]
}
