# perf-optimizer: remove the blocking call from the request path.
# {{fix.publish}}
# {{fix.hikari}}
#
# The request thread blocks on EventBridge (CompletableFuture.get) while the single
# Hikari connection serializes DB access — under load the wall profile is dominated
# by futex/park. Publish without blocking and give the pool room. (Production-grade:
# move the publish to a @TransactionalEventListener(phase = AFTER_COMMIT) so events
# fire only after the transaction commits.)

--- a/src/main/java/com/unicorn/store/service/UnicornService.java
+++ b/src/main/java/com/unicorn/store/service/UnicornService.java
@@ private void publishUnicornEvent(Unicorn unicorn, UnicornEventType eventType) @@
-            unicornPublisher.publish(unicorn, eventType).get();
+            // Do not block the request thread on EventBridge; log on completion.
+            unicornPublisher.publish(unicorn, eventType)
+                .whenComplete((resp, err) -> {
+                    if (err != null) {
+                        logger.error("Failed to publish {} event for unicorn ID: {}",
+                            eventType, unicorn.getId(), err);
+                    }
+                });

--- a/src/main/resources/application.yaml
+++ b/src/main/resources/application.yaml
@@ spring.datasource.hikari @@
-      maximum-pool-size: 1
+      maximum-pool-size: 10
