# perf-optimizer: with a sidecar in the pod, a pod-level Resource metric averages
# app+sidecar CPU and mis-scales. Switch the HPA metric to ContainerResource so it
# reads ONLY the {{metric.container}} container. Apply to k8s/hpa.yaml (spec.metrics).
  metrics:
    - type: {{metric.type}}
      containerResource:
        name: cpu
        container: {{metric.container}}
        target:
          type: Utilization
          averageUtilization: 70
