# perf-optimizer: right-size {{deployment}} MEMORY off the MEASURED working-set
# (requests near the floor, limits = max(peak + headroom, 1.9x floor)). Keep SerialGC
# on 1 vCPU / small heap. This patch changes ONLY memory + JAVA_TOOL_OPTIONS and
# PRESERVES the current CPU values, so it composes with the CPU-boost patch in either
# order. Apply under spec.template.spec.containers[0] in k8s/deployment.yaml, then
# re-apply and rollout restart (a memory-limit shrink needs a restart).
        resources:
          requests:
            cpu: "{{current.requests.cpu}}"
            memory: "{{requests.memory}}"
          limits:
            cpu: "{{current.limits.cpu}}"
            memory: "{{limits.memory}}"
        env:
          - name: JAVA_TOOL_OPTIONS
            value: >-
              -XX:+Use{{jvm.gc}}
              -XX:MaxRAMPercentage={{jvm.maxRamPercentage}}
              -XX:InitialRAMPercentage=50
