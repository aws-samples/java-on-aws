{
  "workload": {
    "namespace": "unicorn-store-spring",
    "deployment": "unicorn-store-spring",
    "container": "unicorn-store-spring",
    "imageTag": "latest",
    "replicas": 1,
    "cpuRequestCores": 0.25,
    "cpuLimitCores": 1.0,
    "memRequestMi": 512.0,
    "memLimitMi": 768.0,
    "cpuResizePolicy": true,
    "javaToolOptions": "-XX:+UseSerialGC -XX:MaxRAMPercentage=75",
    "sidecars": ["perf-profiler"]
  },
  "runtime": {
    "rssFloorMi": 400.0,
    "rssPeakMi": 517.0,
    "heapUsedMi": 60.0,
    "heapCommittedMi": 88.0,
    "gcName": "SerialGC",
    "effectiveCpuCount": 1,
    "startupSeconds": 12.7,
    "restarts": 0,
    "uptimeSeconds": 3600.0,
    "requestRatePerSec": 50
  },
  "profile": {
    "topCpu": [{"name": "com/unicorn/store/service/UnicornService.createUnicorn", "selfPct": 5.0}],
    "topWall": [
      {"name": "__futex_abstimed_wait_common", "selfPct": 60.0},
      {"name": "com/zaxxer/hikari/util/ConcurrentBag.borrow", "selfPct": 19.9}
    ],
    "jitSharePct": 4.0,
    "gcSharePct": 5.0,
    "futexWallSharePct": 79.9,
    "warmupWindow": false,
    "samples": 5182
  },
  "threads": {
    "threadCountByState": {"RUNNABLE": 4, "TIMED_WAITING": 30, "WAITING": 20},
    "poolWaitCarriers": 2,
    "futureGetOnRequestPath": true
  }
}
