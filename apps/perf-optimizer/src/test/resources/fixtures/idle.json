{
  "workload": {
    "namespace": "unicorn-store-spring",
    "deployment": "unicorn-store-spring",
    "container": "unicorn-store-spring",
    "imageTag": "latest",
    "replicas": 1,
    "cpuRequestCores": 1.0,
    "cpuLimitCores": 1.0,
    "memRequestMi": 2048.0,
    "memLimitMi": 2048.0,
    "cpuResizePolicy": false,
    "javaToolOptions": null,
    "sidecars": ["perf-profiler"],
    "hpaPresent": false,
    "hpaMetricType": null
  },
  "runtime": {
    "rssFloorMi": 340.0,
    "rssPeakMi": 342.0,
    "heapUsedMi": 50.0,
    "heapCommittedMi": 80.0,
    "gcName": "SerialGC",
    "effectiveCpuCount": 1,
    "startupSeconds": 13.0,
    "restarts": 0,
    "uptimeSeconds": 3600.0,
    "requestRatePerSec": 0.0
  },
  "profile": {
    "topCpu": [{"name": "com/unicorn/store/service/UnicornService.createUnicorn", "selfPct": 6.0}],
    "topWall": [{"name": "jdk/internal/misc/Unsafe.park", "selfPct": 12.0}],
    "jitSharePct": 6.0,
    "gcSharePct": 5.0,
    "futexWallSharePct": 85.0,
    "warmupWindow": false,
    "samples": 5000
  },
  "threads": {
    "threadCountByState": {"RUNNABLE": 8, "TIMED_WAITING": 20},
    "poolWaitCarriers": 0,
    "futureGetOnRequestPath": false
  }
}
