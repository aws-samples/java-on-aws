{
  "testDefaults": {
    "blockTimeoutSeconds": 600,
    "delayBetweenBlocksSeconds": 5,
    "environmentFiles": [
      "/etc/profile.d/workshop.sh"
    ]
  },
  "workshops": [
    {
      "template": "java-on-aws",
      "repository": "java-on-aws-immersion-day",
      "policies": ["common", "java-on-aws"],
      "test": {
        "enabled": true,
        "title": "Java on AWS - Containers"
      }
    },
    {
      "template": "java-on-amazon-eks",
      "repository": "java-on-amazon-eks",
      "policies": ["common", "java-on-amazon-eks"],
      "test": {
        "enabled": true,
        "title": "Cloud-native Java on Amazon EKS"
      }
    },
    {
      "template": "java-performance",
      "repository": "java-performance",
      "policies": ["common", "java-performance"],
      "test": {
        "enabled": true,
        "title": "Java performance optimization"
      }
    },
    {
      "template": "java-spring-ai-agents",
      "repository": "java-spring-ai-agents"
    },
    {
      "template": "java-ai-agents",
      "repository": "java-ai-agents"
    },
    {
      "template": "java-ai-agents-advanced",
      "repository": "java-ai-agents-advanced"
    }
  ]
}
